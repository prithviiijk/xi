<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The PetShop | Karkala • Moodbidri • Mangalore</title>
  <style>
    :root {
      --primary: #2d6a4f;
      --accent: #d90429;
      --bg: #f8f9fa;
      --card-bg: #ffffff;
    }
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); margin: 0; padding: 0; }
    
    header { background: var(--primary); color: white; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
    .logo { font-size: 1.8rem; font-weight: bold; }
    
    .container { display: flex; padding: 20px; gap: 20px; }
    
    /* Filters Sidebar */
    .sidebar { width: 250px; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .filter-group { margin-bottom: 15px; }
    .filter-group label { display: block; font-weight: bold; margin-bottom: 5px; }
    .filter-group select, .filter-group input { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; }

    /* Product Grid */
    .grid { flex: 1; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
    
    .card { background: var(--card-bg); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); position: relative; display: flex; flex-direction: column; }
    .card img { width: 100%; height: 200px; object-fit: cover; }
    .card-body { padding: 15px; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
    .price { font-size: 1.2rem; font-weight: bold; color: var(--primary); }
    
    /* Sold Ribbon on Left Side */
    .sold-badge {
      position: absolute;
      top: 10px;
      left: 0;
      background: var(--accent);
      color: white;
      padding: 5px 15px;
      font-weight: bold;
      font-size: 0.85rem;
      text-transform: uppercase;
      box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
      border-top-right-radius: 4px;
      border-bottom-right-radius: 4px;
    }

    .btn { background: var(--primary); color: white; border: none; padding: 10px; width: 100%; border-radius: 4px; cursor: pointer; font-weight: bold; }
    .btn:hover { opacity: 0.9; }

    footer { background: #1a1a1a; color: white; text-align: center; padding: 20px; margin-top: 40px; }
  </style>
</head>
<body>

  <header>
    <div class="logo">🐾 The PetShop</div>
    <div>
      <span>📍 Locations: Karkala | Moodbidri | Mangalore</span>
    </div>
  </header>

  <div class="container">
    <!-- Filters Sidebar -->
    <aside class="sidebar">
      <h3>Filter Pets</h3>
      
      <div class="filter-group">
        <label>Category</label>
        <select id="category">
          <option value="all">All Categories</option>
          <option value="dog">Dog</option>
          <option value="cat">Cat</option>
          <option value="birds">Birds</option>
          <option value="reptiles">Reptiles</option>
          <option value="fishes">Fishes</option>
          <option value="hamsters">Hamsters</option>
        </select>
      </div>

      <div class="filter-group">
        <label>Gender</label>
        <select id="gender">
          <option value="all">All</option>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
          <option value="Not Known">Not Known</option>
        </select>
      </div>

      <div class="filter-group">
        <label>Max Price (₹)</label>
        <input type="number" id="maxPrice" placeholder="e.g. 15000">
      </div>

      <button class="btn" onclick="applyFilters()">Apply Filters</button>
    </aside>

    <!-- Listings Grid -->
    <main class="grid" id="petGrid">
      
      <!-- Sample Pet Card (Booked/Sold Example) -->
      <div class="card">
        <div class="sold-badge">SOLD</div>
        <img src="https://via.placeholder.com/300x200" alt="Golden Retriever">
        <div class="card-body">
          <h3>Golden Retriever</h3>
          <p>Breed: Retriever | Age: 2 Months</p>
          <p>Gender: Male | Color: Golden</p>
          <div class="price">₹25,000</div>
          <button class="btn" disabled style="background:#ccc; cursor:not-allowed;">Already Booked</button>
        </div>
      </div>

      <!-- Sample Pet Card (Available Example) -->
      <div class="card">
        <img src="https://via.placeholder.com/300x200" alt="Persian Cat">
        <div class="card-body">
          <h3>Persian Kitten</h3>
          <p>Breed: Persian | Age: 3 Months</p>
          <p>Gender: Female | Color: White</p>
          <div class="price">₹12,000</div>
          <p style="font-size:0.8rem; color:#666;">Pay 20% (₹2,400) to Book</p>
          <button class="btn" onclick="openCheckout('Persian Kitten', 12000, 'pet')">Book Now (20%)</button>
        </div>
      </div>

    </main>
  </div>

  <footer>
    <p> Email: contact@thepetshop.com |  Phone: +91 98765 43210</p>
    <p>Serving Karkala, Moodbidri & Mangalore</p>
  </footer>

</body>
</html>
